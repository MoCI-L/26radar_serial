	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_serial.dir/build.make CMakeFiles/test_serial.dir/test/test_serial.cpp.o
.PHONY : test/test_serial.cpp.o

test/test_serial.i: test/test_serial.cpp.i
.PHONY : test/test_serial.i

# target to preprocess a source file
test/test_serial.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_serial.dir/build.make CMakeFiles/test_serial.dir/test/test_serial.cpp.i
.PHONY : test/test_serial.cpp.i

test/test_serial.s: test/test_serial.cpp.s
.PHONY : test/test_serial.s

# target to generate assembly for a file
test/test_serial.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_serial.dir/build.make CMakeFiles/test_serial.dir/test/test_serial.cpp.s
.PHONY : test/test_serial.cpp.s

