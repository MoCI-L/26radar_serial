<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>radar_comm</name>
  <version>0.0.0</version>
  <description>RoboMaster radar/referee transport bridge with protocol parsing, ROS2 publishing, Boost.Asio cross-platform I/O, and runtime diagnostics.</description>
  <maintainer email="liu2336@outlook.com">moci</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>boost</depend>
  <depend>builtin_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>radar_interfaces</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
